    border: '1.5px solid #E2E8F0',
    fontSize: '13px',
    color: '#0F172A',
    boxSizing: 'border-box',
    outline: 'none',
  },
  select: {
    width: '100%',
    padding: '9px 12px',
    borderRadius: '10px',
    border: '1.5px solid #E2E8F0',
    fontSize: '13px',
    color: '#0F172A',
    backgroundColor: '#FFFFFF',
    boxSizing: 'border-box',
    outline: 'none',
  },
  textarea: {
    width: '100%',
    padding: '9px 12px',
    borderRadius: '10px',
    border: '1.5px solid #E2E8F0',
    fontSize: '13px',
    color: '#0F172A',
    resize: 'none',
    boxSizing: 'border-box',
    fontFamily: 'inherit',
    outline: 'none',
  },
  uploadDropzone: {
    border: '2px dashed #CBD5E1',
    borderRadius: '14px',
    padding: '24px',
    backgroundColor: '#F8FAFC',
    display: 'flex',
    flexDirection: 'column',
    alignItems: 'center',
    justifyContent: 'center',
    cursor: 'pointer',
  },
  privacyBox: {
    display: 'flex',
    justifyContent: 'space-between',
    alignItems: 'center',
    backgroundColor: '#F1F5F9',
    padding: '12px 14px',
    borderRadius: '10px',
    border: '1px solid #E2E8F0',
  },
  reviewSummaryBox: {
    backgroundColor: '#F8FAFC',
    border: '1px solid #E2E8F0',
    borderRadius: '12px',
    padding: '14px 18px',
    display: 'flex',
    flexDirection: 'column',
    gap: '10px',
  },
  reviewRow: {
    display: 'flex',
    justifyContent: 'space-between',
    fontSize: '13px',
    color: '#1E293B',
  },
  reviewLabel: {
    color: '#64748B',
  },
  wizardFooter: {
    marginTop: '20px',
    paddingTop: '16px',
    borderTop: '1px solid #F1F5F9',
    display: 'flex',
    justifyContent: 'space-between',
    alignItems: 'center',
  },
  backBtn: {
    padding: '9px 16px',
    borderRadius: '8px',
    border: '1px solid #CBD5E1',
    backgroundColor: '#FFFFFF',
    color: '#475569',
    fontWeight: 600,
    fontSize: '13px',
    cursor: 'pointer',
