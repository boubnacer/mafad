    height: '28px',
    borderRadius: '50%',
    backgroundColor: '#E2E8F0',
    color: '#64748B',
    fontSize: '12px',
    fontWeight: 700,
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'center',
    flexShrink: 0,
  },
  railCircleActive: {
    backgroundColor: '#1A73E8',
    color: '#FFFFFF',
    boxShadow: '0 0 0 3px rgba(26, 115, 232, 0.2)',
  },
  railCircleDone: {
    backgroundColor: '#10B981',
    color: '#FFFFFF',
  },
  railLabel: {
    fontSize: '13px',
    lineHeight: '1.2',
  },
  railSubtitle: {
    fontSize: '11px',
    color: '#94A3B8',
    marginTop: '2px',
  },
  contentPane: {
    flex: 1,
    padding: '22px 26px',
    display: 'flex',
    flexDirection: 'column',
    justifyContent: 'space-between',
    backgroundColor: '#FFFFFF',
  },
  stepContainer: {
    display: 'flex',
    flexDirection: 'column',
    gap: '14px',
  },
  fieldGroup: {
    display: 'flex',
    flexDirection: 'column',
    gap: '6px',
  },
  label: {
    fontSize: '12px',
    fontWeight: 700,
    color: '#334155',
  },
  dualToggleGrid: {
    display: 'grid',
    gridTemplateColumns: '1fr 1fr',
