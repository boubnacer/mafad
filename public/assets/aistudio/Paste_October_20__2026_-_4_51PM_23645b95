    justifyContent: 'space-between',
    alignItems: 'center',
    backgroundColor: '#FFFFFF',
  },
  wizardTitle: {
    fontSize: '18px',
    fontWeight: 700,
    color: '#0F172A',
    margin: 0,
  },
  wizardSubtitle: {
    fontSize: '12px',
    color: '#64748B',
    marginTop: '2px',
    margin: 0,
  },
  closeBtn: {
    background: 'none',
    border: 'none',
    fontSize: '18px',
    color: '#94A3B8',
    cursor: 'pointer',
  },
  ghostBtn: {
    backgroundColor: '#F1F5F9',
    border: '1px solid #E2E8F0',
    borderRadius: '8px',
    padding: '6px 12px',
    fontSize: '12px',
    fontWeight: 600,
    color: '#1A73E8',
    cursor: 'pointer',
  },
  wizardLayout: {
    display: 'flex',
    minHeight: '430px',
  },
  stepperRail: {
    width: '210px',
    backgroundColor: '#F8FAFC',
    borderRight: '1px solid #F1F5F9',
    padding: '20px 14px',
    display: 'flex',
    flexDirection: 'column',
    gap: '8px',
  },
  railItem: {
    display: 'flex',
    alignItems: 'center',
    gap: '10px',
